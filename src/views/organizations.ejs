<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="Our partner organizations – CSE 340 Service Network connects you with trusted nonprofits and community groups.">
    <title>
        <%= title %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>
    <%- include('partials/header') %>

        <main class="page-main">
            <div class="page-hero">
                <div class="container">
                    <h1 class="page-title">
                        <%= title %>
                    </h1>
                    <p class="page-subtitle">Meet the organizations powering positive change in our communities.</p>
                </div>
            </div>

            <section class="container org-section">
                <ul class="org-list" id="organizationsList">
                    <% organizations.forEach(org=> { %>
                        <li class="org-card">
                            <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo" class="org-logo">
                            <div class="org-info">
                                <h2 class="org-name">
                                    <a href="/organization/<%= org.organization_id %>">
                                        <%= org.name %>
                                    </a>
                                </h2>
                                <p class="org-contact">
                                    <span class="contact-label">Contact:</span>
                                    <a href="mailto:<%= org.contact_email %>">
                                        <%= org.contact_email %>
                                    </a>
                                </p>
                            </div>
                        </li>
                        <% }); %>
                </ul>

                <a href="/new-organization" class="btn btn-primary">Add New Organization</a>

            </section>
        </main>

        <%- include('partials/footer') %>
</body>

</html>