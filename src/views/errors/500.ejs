<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Server error – CSE 340 Service Network.">
    <title>500 – Server Error | CSE 340 Service Network</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>
    <%- include('../partials/header') %>

    <main class="page-main">
        <div class="error-page" id="error500Page">
            <div class="error-code error-code--500">500</div>
            <h1 class="error-title">Something Went Wrong</h1>
            <p class="error-message">We are experiencing technical difficulties. Our team has been notified and is working to fix the issue.</p>
            <a href="/" class="btn btn-primary">Return to Homepage</a>

            <% if (NODE_ENV === 'development') { %>
                <details class="error-details" open id="errorDetails">
                    <summary>Error Details <span class="error-dev-badge">Development Only</span></summary>
                    <pre class="error-pre"><%= error %></pre>
                    <pre class="error-pre"><%= stack %></pre>
                </details>
            <% } %>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>

</html>