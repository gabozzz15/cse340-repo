<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="Upcoming service projects – find volunteering opportunities near you through the CSE 340 Service Network.">
    <title>
        <%= title %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>
    <%- include('partials/header') %>

        <main class="page-main">
            <div class="page-hero">
                <div class="container">
                    <h1 class="page-title">
                        <%= title %>
                    </h1>
                    <p class="page-subtitle">Join us in making a difference through these service opportunities.</p>
                </div>
            </div>

            <section class="container projects-section">
                <% if (projects && projects.length> 0) { %>
                    <div class="projects-grid">
                        <% projects.forEach(project=> { %>
                            <div class="project-card">
                                <div class="project-header">
                                    <h2 class="project-title">
                                        <a href="/project/<%= project.project_id %>" class="project-title-link">
                                            <%= project.title %>
                                        </a>
                                    </h2>
                                    <a href="/organization/<%= project.organization_id %>" class="project-organization">
                                        <%= project.organization_name %>
                                    </a>
                                </div>

                                <div class="project-purpose">
                                    <h3 class="section-label">Purpose</h3>
                                    <p class="project-description">
                                        <%= project.description %>
                                    </p>
                                </div>

                                <div class="project-location-section">
                                    <h3 class="section-label">Location</h3>
                                    <p class="project-location">
                                        <%= project.location %>
                                    </p>
                                </div>

                                <div class="project-date-section">
                                    <h3 class="section-label">Date</h3>
                                    <p class="project-date">
                                        <%= project.project_date.toLocaleDateString() %>
                                    </p>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } else { %>
                        <p class="no-projects">No service projects are currently available. Please check back soon!</p>
                        <% } %>
            </section>

            <div class="container">
                <p><a href="/new-project">Add a New Service Project</a></p>
            </div>
        </main>

        <%- include('partials/footer') %>
</body>

</html>