<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="Service project categories – browse Environmental, Educational, Community Service, and Health &amp; Wellness opportunities.">
    <title>
        <%= title %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>
    <%- include('partials/header') %>

        <main class="page-main">
            <div class="page-hero">
                <div class="container">
                    <h1 class="page-title">
                        <%= title %>
                    </h1>
                    <p class="page-subtitle">Browse service opportunities by category.</p>
                </div>
            </div>

            <section class="container categories-section">
                <% if (categories && categories.length> 0) { %>
                    <div class="categories-grid">
                        <% categories.forEach(category=> { %>
                            <div class="category-card">
                                <div class="category-icon">
                                    <!-- Icono temporal, puedes cambiarlo después -->
                                    <span>📁</span>
                                </div>
                                <h2 class="category-name">
                                    <%= category.name %>
                                </h2>
                                <p class="category-description">
                                    <!-- Descripción genérica, se mejorará en W03 -->
                                    Service projects related to <%= category.name.toLowerCase() %>
                                </p>
                            </div>
                            <% }); %>
                    </div>
                    <% } else { %>
                        <p class="no-categories">No categories are currently available.</p>
                        <% } %>
            </section>
        </main>

        <%- include('partials/footer') %>
</body>

</html>