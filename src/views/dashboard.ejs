<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Dashboard - CSE 340 Service Network">
    <title>Dashboard - CSE 340 Service Network</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>
    <%- include('partials/header') %>

    <main class="page-main">
        <section class="container">
            <h1><%= title %></h1>

            <div class="org-detail-card" style="margin-top: 1.5rem;">
                <div class="org-detail-header">
                    <div class="org-detail-meta">
                        <span class="org-detail-name">Welcome, <%= name %>!</span>
                        <span class="org-detail-email"><%= email %></span>
                    </div>
                </div>
                <div class="org-detail-body">
                    <p class="org-detail-description">
                        You are logged in as <strong><%= name %></strong>. 
                        Use the navigation above to explore organizations, projects, and categories.
                    </p>
                    
                    <% if (user && user.role_name === 'admin') { %>
                        <div style="margin-top: 1.5rem; border-top: 1px solid var(--color-border); padding-top: 1.5rem;">
                            <h3 class="org-detail-section-title">Administrative Actions</h3>
                            <p style="margin-bottom: 1rem; color: var(--color-text-muted);">As an administrator, you have access to additional features below:</p>
                            <a href="/users" class="btn btn-primary">Manage Registered Users</a>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="org-projects-block" style="margin-top: 2rem;">
                <h2 class="org-detail-section-title">My Volunteer Projects</h2>
                <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
                    <div class="org-project-list" style="margin-top: 1rem;">
                        <% volunteeredProjects.forEach(project => { %>
                            <div class="org-project-item" style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; border: 1px solid var(--color-border); border-radius: var(--radius); padding: 0.75rem 1rem; background: var(--color-bg); margin-bottom: 0.50rem;">
                                <a href="/project/<%= project.project_id %>" style="display: flex; flex-direction: column; text-decoration: none; flex: 1;">
                                    <span class="org-project-title" style="font-weight: 600; color: var(--color-primary);"><%= project.title %></span>
                                    <span class="org-project-location" style="font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.2rem;">
                                        🏢 <%= project.organization_name %> | 📍 <%= project.location %>
                                    </span>
                                    <span class="org-project-date" style="font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.1rem;">
                                        🗓 <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                    </span>
                                </a>
                                <a href="/project/<%= project.project_id %>/remove-volunteer" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.4rem 0.8rem; flex-shrink: 0;">Remove</a>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p style="color: var(--color-text-muted); margin-top: 0.50rem;">You haven't volunteered for any projects yet.</p>
                <% } %>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
