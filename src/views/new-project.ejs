<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Add a new service project - CSE 340 Service Network">
    <title>Add New Service Project - CSE 340 Service Network</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>
    <%- include('partials/header') %>

    <main class="page-main">
        <section class="container">
            <h1><%= title %></h1>
            <form action="/new-project" method="POST">

                <div class="form-group">
                    <label for="title">Project Title</label>
                    <input
                        type="text"
                        id="title"
                        name="title"
                        maxlength="200"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea
                        id="description"
                        name="description"
                        maxlength="1000"
                        required
                    ></textarea>
                </div>

                <div class="form-group">
                    <label for="location">Location</label>
                    <input
                        type="text"
                        id="location"
                        name="location"
                        maxlength="200"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="date">Date</label>
                    <input
                        type="date"
                        id="date"
                        name="date"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="organizationId">Organization</label>
                    <select
                        id="organizationId"
                        name="organizationId"
                        required
                    >
                        <option value="">Select an organization</option>
                        <% organizations.forEach(org => { %>
                            <option value="<%= org.organization_id %>"><%= org.name %></option>
                        <% }); %>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">Create Project</button>
            </form>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
