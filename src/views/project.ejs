<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Service project details – CSE 340 Service Network.">
    <title><%= title %> | CSE 340 Service Network</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>
    <%- include('partials/header') %>

    <main class="page-main">
        <div class="page-hero">
            <div class="container">
                <h1 class="page-title"><%= title %></h1>
                <p class="page-subtitle">Details for this service project.</p>
            </div>
        </div>

        <section class="container project-detail-section">
            <% if (!project) { %>
                <p class="no-projects">Project not found.</p>
            <% } else { %>

                <div class="project-detail-card">

                    <div class="project-detail-header">
                        <h2 class="project-detail-title"><%= project.title %></h2>
                        <a href="/organization/<%= project.organization_id %>" class="project-detail-org-link">
                            <%= project.organization_name %>
                        </a>
                    </div>

                    <div class="project-detail-body">

                        <div class="project-detail-row">
                            <span class="org-detail-section-title">Purpose</span>
                            <p class="project-detail-text"><%= project.description %></p>
                        </div>

                        <div class="project-detail-row">
                            <span class="org-detail-section-title">Location</span>
                            <p class="project-detail-text">📍 <%= project.location %></p>
                        </div>

                        <div class="project-detail-row">
                            <span class="org-detail-section-title">Date</span>
                            <p class="project-detail-text">
                                🗓 <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                            </p>
                        </div>

                        <% if (categories && categories.length > 0) { %>
                        <div class="project-detail-row">
                            <span class="org-detail-section-title">Categories</span>
                            <div class="project-category-tags">
                                <% categories.forEach(cat => { %>
                                    <a href="/category/<%= cat.category_id %>" class="category-tag">
                                        📁 <%= cat.name %>
                                    </a>
                                <% }) %>
                            </div>
                        </div>
                        <% } %>

                        <% if (isLoggedIn) { %>
                            <div class="project-detail-row" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-top: 1.5rem;">
                                <% if (isVolunteering) { %>
                                    <span class="category-tag" style="background: #d4edda; color: #155724; border-color: #c3e6cb; font-size: 0.9rem; padding: 0.4rem 1rem;">
                                        ✓ You are volunteering for this project
                                    </span>
                                    <a href="/project/<%= project.project_id %>/remove-volunteer" class="btn btn-secondary">Remove Volunteering</a>
                                <% } else { %>
                                    <span style="font-weight: 600; color: var(--color-text-muted);">Interested in helping out?</span>
                                    <a href="/project/<%= project.project_id %>/volunteer" class="btn btn-primary">Volunteer for this Project</a>
                                <% } %>
                            </div>
                        <% } %>

                    </div>
                </div>

                <div class="project-detail-back">
                    <a href="/projects" class="btn btn-secondary">← Back to Upcoming Projects</a>
                    <a href="/organization/<%= project.organization_id %>" class="btn btn-secondary">View Organization</a>
                    <% if (user && user.role_name === 'admin') { %>
                        <a href="/assign-categories/<%= project.project_id %>" class="btn btn-primary">Edit Categories</a>
                        <a href="/edit-project/<%= project.project_id %>" class="btn btn-primary">Edit Project</a>
                    <% } %>
                </div>

            <% } %>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
